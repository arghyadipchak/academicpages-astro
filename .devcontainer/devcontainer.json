{
  "name": "Academic Pages Astro Dev Container",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:26",
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Astro Development Server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "pnpm install"
}
