{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",
  "default": true,
  // MD007/ul-indent: Indent by 2 spaces matching Prettier tabWidth
  "MD007": { "indent": 2 },
  // MD013/line-length: Handled by editor and Prettier formatting
  "MD013": false,
  // MD030/list-marker-space: Prettier handles spaces after list markers
  "MD030": false,
  // MD024/no-duplicate-heading: Allow duplicate headings across different parent sections
  "MD024": { "siblings_only": true },
  // MD025/single-title/single-h1: Titles are usually specified in frontmatter
  "MD025": false,
  // MD026/no-trailing-punctuation: Exclude exclamation mark from forbidden punctuation
  "MD026": { "punctuation": ".,;:。，；：" },
  // MD028/no-blanks-blockquote: Allow consecutive blockquotes separated by blank lines
  "MD028": false,
  // MD033/no-inline-html: Allow inline HTML elements in markdown documents
  "MD033": false,
  // MD041/first-line-heading: First line may not be a heading due to frontmatter or introductory content
  "MD041": false,
  // MD042/no-empty-links: Allow placeholder links (#) in template/demo pages
  "MD042": false,
  // MD059/descriptive-link-text: Allow standard/sample link text in guides
  "MD059": false
}
