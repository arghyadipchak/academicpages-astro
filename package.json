{
  "name": "academicpages-astro",
  "description": "An academic website and portfolio template powered by Astro 7, TypeScript, and Tailwind CSS v4",
  "version": "0.2.0",
  "author": "Arghyadip Chakraborty<dev@arghyac.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test": "playwright test",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck",
    "generate:favicons": "node --experimental-strip-types scripts/generate-favicons.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/academicons": "^1.2.4",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "astro-icon": "^1.2.0",
    "katex": "^0.18.7",
    "marked": "^18.0.13",
    "marked-katex-extension": "^5.1.13",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.63.0",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "<6.1.0",
    "typescript-eslint": "^8.70.0"
  }
}
