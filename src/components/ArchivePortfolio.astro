---
import { parseInline } from '../utils/marked';
import { resolveUrl } from '../utils/url';

export interface Props {
  title: string;
  url: string;
  description?: string;
  image?: string;
}

const { title, url, description, image } = Astro.props;
---

<div
  class="archive__item border-b border-(--global-border-color) py-6 first:pt-0 last:border-b-0 sm:py-8"
>
  <article itemscope itemtype="http://schema.org/CreativeWork">
    <h3 class="text-lg font-bold tracking-tight" itemprop="headline">
      <a
        href={url}
        rel="permalink"
        class="text-(--global-link-color) hover:text-(--global-link-color-hover) hover:underline"
        set:html={parseInline(title)}
      />
    </h3>

    {
      description && (
        <div
          class="mt-2 text-sm text-(--global-text-color)"
          itemprop="description"
          set:html={parseInline(description)}
        />
      )
    }

    {
      image && (
        <div class="mt-3 overflow-hidden rounded-md">
          <img
            src={resolveUrl(image)}
            alt={title}
            class="h-auto max-h-60 w-full object-cover"
            loading="lazy"
          />
        </div>
      )
    }
  </article>
</div>
