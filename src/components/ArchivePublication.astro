---
import { formatYear } from '../utils/date';
import { renderMath } from '../utils/math';
import { resolveHtmlUrls } from '../utils/url';
import ActionBadges from './ActionBadges.astro';

export interface Props {
  title: string;
  url: string;
  description?: string;
  date?: Date;
  venue?: string;
  citation?: string;
  pdfUrl?: string;
  paperUrl?: string;
  slidesUrl?: string;
  codeUrl?: string;
  bibtex?: string;
}

const {
  title,
  url,
  description,
  date,
  venue,
  citation,
  pdfUrl: rawPdfUrl,
  paperUrl,
  slidesUrl,
  codeUrl,
  bibtex,
} = Astro.props;

const pdfUrl = rawPdfUrl ?? paperUrl;
const formattedYear = formatYear(date);
---

<div
  class="archive__item border-b border-(--global-border-color) py-4 first:pt-0 last:border-b-0"
>
  <article itemscope itemtype="http://schema.org/CreativeWork">
    <h3 class="text-lg font-bold tracking-tight" itemprop="headline">
      <a
        href={url}
        rel="permalink"
        class="text-(--global-link-color) hover:text-(--global-link-color-hover) hover:underline"
        set:html={renderMath(title)}
      />
    </h3>

    {
      venue && (
        <p class="mt-1 text-sm text-(--global-text-color-light)">
          Published in <em>{venue}</em>
          {formattedYear ? `, ${formattedYear}` : ''}
        </p>
      )
    }

    {
      description && (
        <p
          class="mt-2 text-sm text-(--global-text-color)"
          itemprop="description"
          set:html={resolveHtmlUrls(renderMath(description))}
        />
      )
    }

    {
      citation && (
        <p class="mt-2 text-xs text-(--global-text-color-light)">
          <strong>Recommended citation:</strong>{' '}
          <span set:html={resolveHtmlUrls(renderMath(citation))} />
        </p>
      )
    }

    <ActionBadges
      pdfUrl={pdfUrl}
      slidesUrl={slidesUrl}
      codeUrl={codeUrl}
      bibtex={bibtex}
    />
  </article>
</div>
