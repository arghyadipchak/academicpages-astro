---
import { Icon } from 'astro-icon/components';
import { renderMath } from '../utils/math';

export interface Props {
  title: string;
  url: string;
  date?: Date;
  venue?: string;
  location?: string;
  type?: string;
  excerpt?: string;
}

const { title, url, date, venue, location, type, excerpt } = Astro.props;

const formattedDate = date
  ? new Date(date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : undefined;
---

<div
  class="archive__item border-b border-(--global-border-color) py-4 first:pt-0 last:border-b-0"
>
  <article itemscope itemtype="http://schema.org/CreativeWork">
    <h3 class="text-lg font-bold tracking-tight" itemprop="headline">
      <a
        href={url}
        rel="permalink"
        class="text-(--global-link-color) hover:text-(--global-link-color-hover) hover:underline"
        set:html={renderMath(title)}
      />
    </h3>

    {
      formattedDate && (
        <p class="archive-date-line mt-1 inline-flex items-center gap-1.5 text-xs leading-none text-(--global-text-color-light)">
          <Icon name="fa6-solid:calendar" class="h-3 w-3 shrink-0" />
          <time datetime={date ? new Date(date).toISOString() : undefined}>
            {formattedDate}
          </time>
        </p>
      )
    }

    {
      (type || venue || location) && (
        <p class="mt-1 text-sm text-(--global-text-color-light)">
          {type ? `${type} at ` : ''}
          {venue}
          {location ? `, ${location}` : ''}
        </p>
      )
    }

    {
      excerpt && (
        <p
          class="mt-2 text-sm text-(--global-text-color)"
          itemprop="description"
          set:html={renderMath(excerpt)}
        />
      )
    }
  </article>
</div>
