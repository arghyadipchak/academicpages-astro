---

<div
  class="author-profile text-(--global-text-color)"
  itemscope
  itemtype="http://schema.org/Person"
>
  <div class="flex flex-row items-center gap-4 lg:flex-col lg:items-start lg:gap-0">
    <!-- Avatar -->
    <div class="author__avatar shrink-0">
      <img
        src={resolvePath(author.avatar)}
        alt={author.name}
        width="144"
        height="144"
        class="h-16 w-16 rounded-full border border-(--global-border-color) object-cover sm:h-20 sm:w-20 lg:h-36 lg:w-36 lg:p-1"
        loading="eager"
        decoding="async"
      />
    </div>

    <!-- Name & Bio -->
    <div class="author__content flex-1 lg:mt-3 lg:w-full">
      <h3
        class="text-lg font-bold text-(--global-text-color) lg:text-xl"
        itemprop="name"
      >
        {author.name}
      </h3>
      {author.pronouns && (
        <p class="text-xs text-(--global-text-color-light)">
          {author.pronouns}
        </p>
      )}
      {author.bio && (
        <p
          class="mt-1 text-sm text-(--global-text-color-light) lg:mt-2"
          set:html={parseInline(author.bio)}
        />
      )}
    </div>

    <!-- Mobile Follow Button -->
    <div class="lg:hidden">
      <button
        id="author-urls-toggle"
        type="button"
        class="cursor-pointer rounded-md border border-(--global-dark-border-color) px-3 py-1.5 text-xs font-semibold text-(--global-text-color) hover:bg-(--global-footer-bg-color) focus:outline-none"
        aria-expanded="false"
        aria-controls="author-urls-list"
      >
        Follow
      </button>
    </div>
  </div>

  <!-- Social & Academic Links -->
  <div
    id="author-urls-list"
    class="author__urls hidden pt-4 text-sm lg:block lg:pt-4"
  >
    <ul class="space-y-2 text-sm text-(--global-text-color)">
      {author.location && (
        <li class="flex items-center gap-2.5">
          <Icon
            name="fa6-solid:location-dot"
            class="h-4 w-4 shrink-0 text-(--global-text-color-light)"
          />
          <span itemprop="address">{author.location}</span>
        </li>
      )}
      {author.employer && (
        <li class="flex items-center gap-2.5">
          <Icon
            name="fa6-solid:building-columns"
            class="h-4 w-4 shrink-0 text-(--global-text-color-light)"
          />
          <span itemprop="worksFor">{author.employer}</span>
        </li>
      )}
      {author.website && (
        <li class="flex items-center gap-2.5">
          <Icon
            name="fa6-solid:link"
            class="h-4 w-4 shrink-0 text-(--global-text-color-light)"
          />
          <a
            href={author.website}
            target="_blank"
            class="truncate hover:text-(--global-base-color)"
          >
            Website
          </a>
        </li>
      )}
      {author.email && (
        <li class="flex items-center gap-2.5">
          <Icon
            name="fa6-solid:envelope"
            class="h-4 w-4 shrink-0 text-(--global-text-color-light)"
          />
          <a
            href={`mailto:${author.email}`}
            class="truncate hover:text-(--global-base-color)"
          >
            Email
          </a>
        </li>
      )}

      {/* Dynamic Services List */}
      {AUTHOR_SERVICES.map(({ key, label, icon, emoji, prefix, suffix }) => {
        const val = author[key];
        if (!val || typeof val !== 'string') return null;
        const href = prefix ? resolveUrl(val, prefix, suffix) : val;

        return (
          <li class="flex items-center gap-2.5">
            {icon ? (
              <Icon
                name={icon}
                class="h-4 w-4 shrink-0 text-(--global-text-color-light)"
              />
            ) : emoji ? (
              <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center text-xs">
                {emoji}
              </span>
            ) : null}
            <a
              href={href}
              target="_blank"
              class="hover:text-(--global-base-color)"
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</div>

<script>
  function setupAuthorToggle() {
    const toggleBtn = document.getElementById('author-urls-toggle');
    const urlsList = document.getElementById('author-urls-list');
    if (!toggleBtn || !urlsList) return;

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      urlsList.classList.toggle('hidden');
    });
  }

  document.addEventListener('astro:page-load', setupAuthorToggle);
</script>
