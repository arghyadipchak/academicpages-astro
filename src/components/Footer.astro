---
import { siteConfig } from '../data/siteConfig';
import { Icon } from 'astro-icon/components';

const currentYear = new Date().getFullYear();
const todayDate = new Date().toISOString().slice(0, 10);
---

<footer
  class="mt-12 w-full border-t border-(--global-border-color) bg-(--global-footer-bg-color) py-6 text-xs text-(--global-text-color-light) transition-colors duration-200"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Social follow & RSS links -->
    <div class="mb-4">
      <ul
        class="flex flex-wrap items-center gap-4 text-xs font-semibold tracking-wider uppercase"
      >
        <li
          class="inline-flex items-center leading-none text-(--global-text-color)"
        >
          Follow:
        </li>
        {
          siteConfig.author.github && (
            <li class="inline-flex items-center leading-none">
              <a
                href={`https://github.com/${siteConfig.author.github}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 leading-none text-(--global-text-color-light) hover:text-(--global-base-color)"
              >
                <Icon name="fa6-brands:github" class="h-3.5 w-3.5 shrink-0" />
                <span class="inline-flex items-center leading-none">
                  GitHub
                </span>
              </a>
            </li>
          )
        }
        {
          siteConfig.author.bitbucket && (
            <li class="inline-flex items-center leading-none">
              <a
                href={`https://bitbucket.org/${siteConfig.author.bitbucket}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 leading-none text-(--global-text-color-light) hover:text-(--global-base-color)"
              >
                <Icon
                  name="fa6-brands:bitbucket"
                  class="h-3.5 w-3.5 shrink-0"
                />
                <span class="inline-flex items-center leading-none">
                  Bitbucket
                </span>
              </a>
            </li>
          )
        }
        <li class="inline-flex items-center leading-none">
          <a
            href="/rss.xml"
            class="inline-flex items-center gap-1.5 leading-none text-(--global-text-color-light) hover:text-(--global-base-color)"
          >
            <Icon name="fa6-solid:rss" class="h-3.5 w-3.5 shrink-0" />
            <span class="inline-flex items-center leading-none">Feed</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Copyright and credit text -->
    <div class="space-y-1 text-xs text-(--global-text-color-light)">
      <p class="leading-normal">
        <span class="block sm:inline"
          >&copy; {currentYear}&nbsp;{siteConfig.name || siteConfig.title} &middot;
          Powered by <a
            href="https://astro.build"
            rel="nofollow"
            class="underline hover:text-(--global-base-color)">Astro</a
          > &amp; <a
            href="https://github.com/arghyadipchak/academicpages-astro"
            rel="nofollow"
            class="underline hover:text-(--global-base-color)"
            >Academic Pages Astro</a
          ></span
        >
        <span class="hidden sm:inline"> &middot; </span>
        <span class="block sm:inline"
          >Adapted from <a
            href="https://github.com/academicpages/academicpages.github.io"
            rel="nofollow"
            class="underline hover:text-(--global-base-color)">AcademicPages</a
          > &amp; <a
            href="https://mademistakes.com/work/minimal-mistakes-jekyll-theme/"
            rel="nofollow"
            class="underline hover:text-(--global-base-color)"
            >Minimal Mistakes</a
          ></span
        >
      </p>
      <p class="pt-0.5">
        Site last updated {todayDate} &middot; <a
          href="/sitemap/"
          class="font-semibold uppercase hover:text-(--global-base-color)"
          >Sitemap</a
        >
      </p>
    </div>
  </div>
</footer>
