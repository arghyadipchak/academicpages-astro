---
import { siteConfig } from '@data/siteConfig';
import { resolveThemes } from '@data/themes';
import type { CitationMetadata, SchemaOrgNode } from '@utils/seo';
import {
  buildPersonSchema,
  buildScholarlyArticleSchema,
  buildWebSiteSchema,
} from '@utils/seo';
import { getSiteUrls, resolveUrl, stripBasePath } from '@utils/url';

export interface Props {
  title?: string;
  description?: string;
  articleDate?: Date;
  canonicalUrl?: string;
  image?: string;
  citation?: CitationMetadata;
  schemaNodes?: SchemaOrgNode[];
  ogType?: 'website' | 'article' | 'profile';
}

const {
  title,
  description = siteConfig.description,
  articleDate,
  canonicalUrl: propCanonicalUrl,
  image,
  citation,
  schemaNodes = [],
  ogType = articleDate ? 'article' : 'website',
} = Astro.props;

const xHandle = siteConfig.author.x
  ? siteConfig.author.x
      .replace(/^https?:\/\/(x|twitter)\.com\//, '')
      .replace(/^@/, '')
      .split('/')[0]
  : undefined;

const { siteBase, canonicalUrl: defaultCanonicalUrl } = getSiteUrls(
  Astro.url,
  Astro.site
);
const canonicalUrl = propCanonicalUrl || defaultCanonicalUrl;

const pageTitle = title
  ? `${title} ${siteConfig.titleSeparator} ${siteConfig.title}`
  : siteConfig.title;

const pathname = stripBasePath(Astro.url.pathname).replace(/^\/|\/$/g, '');
const ogFallback = pathname ? `/og/${pathname}.svg` : '/og/default.svg';
const effectiveImage = image || ogFallback;

const resolvedImage = effectiveImage.startsWith('http')
  ? effectiveImage
  : new URL(resolveUrl(effectiveImage), siteBase).toString();

const personSchema = buildPersonSchema(
  siteBase,
  siteConfig.author,
  siteConfig.author.avatar
);
const webSiteSchema = buildWebSiteSchema(siteBase);

const scholarlyArticleSchema = citation?.title
  ? buildScholarlyArticleSchema(
      canonicalUrl,
      siteBase,
      citation,
      description,
      resolvedImage
    )
  : null;

const jsonLdGraph: SchemaOrgNode[] = [
  webSiteSchema,
  personSchema,
  ...(scholarlyArticleSchema ? [scholarlyArticleSchema] : []),
  ...schemaNodes,
];

const {
  light: lightTheme,
  dark: darkTheme,
  css: themeCss,
} = resolveThemes(siteConfig.theme);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content={lightTheme.bg} />
<style is:inline set:html={themeCss}></style>
<link rel="icon" type="image/x-icon" href={resolveUrl('/favicon.ico')} />
<link rel="icon" type="image/svg+xml" href={resolveUrl('/favicon.svg')} />
<link
  rel="icon"
  type="image/png"
  sizes="32x32"
  href={resolveUrl('/favicon-32x32.png')}
/>
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href={resolveUrl('/apple-touch-icon.png')}
/>
<link rel="manifest" href={resolveUrl('/site.webmanifest')} />
<link rel="canonical" href={canonicalUrl} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${siteConfig.title} Feed`}
  href={resolveUrl('/rss.xml')}
/>

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:alt" content={pageTitle} />
<meta property="og:locale" content={siteConfig.locale.replace('-', '_')} />
{
  articleDate && (
    <meta
      property="article:published_time"
      content={articleDate.toISOString()}
    />
  )
}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={resolvedImage} />
{
  xHandle && (
    <>
      <meta property="twitter:creator" content={`@${xHandle}`} />
      <meta property="twitter:site" content={`@${xHandle}`} />
    </>
  )
}

<!-- Google Scholar / Highwire Press Academic Meta Tags -->
{citation?.title && <meta name="citation_title" content={citation.title} />}
{
  (citation?.author || (citation?.title && siteConfig.author.name)) && (
    <meta
      name="citation_author"
      content={citation?.author || siteConfig.author.name}
    />
  )
}
{
  citation?.publicationDate && (
    <meta name="citation_publication_date" content={citation.publicationDate} />
  )
}
{
  citation?.journalTitle && (
    <meta name="citation_journal_title" content={citation.journalTitle} />
  )
}
{
  citation?.conferenceTitle && (
    <meta name="citation_conference_title" content={citation.conferenceTitle} />
  )
}
{citation?.pdfUrl && <meta name="citation_pdf_url" content={citation.pdfUrl} />}

<!-- Structured Data (JSON-LD) -->
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': jsonLdGraph,
  })}
/>
<!-- Dark Mode Initialization Script (Prevents flash of unstyled theme) -->
<script
  is:inline
  define:vars={{
    lightBg: lightTheme.bg,
    darkBg: darkTheme.bg,
    hasPicker: Boolean(siteConfig.theme?.picker),
  }}
>
  const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
  function applyTheme(explicitTheme, notify) {
    if (explicitTheme) localStorage.setItem('theme', explicitTheme);
    const storedTheme = explicitTheme || localStorage.getItem('theme');
    const isDark =
      storedTheme === 'dark' || (!storedTheme && darkQuery.matches);
    const theme = isDark ? 'dark' : 'light';
    const root = document.documentElement;
    root.setAttribute('data-theme', theme);
    if (hasPicker) {
      const lp = localStorage.getItem('theme-light-preset');
      const dp = localStorage.getItem('theme-dark-preset');
      if (lp) root.setAttribute('data-light-preset', lp);
      else root.removeAttribute('data-light-preset');
      if (dp) root.setAttribute('data-dark-preset', dp);
      else root.removeAttribute('data-dark-preset');
    }
    const activeBg = hasPicker
      ? getComputedStyle(root).getPropertyValue('--global-bg-color').trim()
      : '';
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', activeBg || (isDark ? darkBg : lightBg));
    if (explicitTheme || notify) {
      document.dispatchEvent(
        new CustomEvent('theme-change', { detail: { theme } })
      );
    }

    return theme;
  }

  window.__applyTheme = applyTheme;
  applyTheme();
  darkQuery.addEventListener('change', () => {
    if (!localStorage.getItem('theme')) applyTheme(undefined, true);
  });
  document.addEventListener('astro:after-swap', () => applyTheme());
</script>
