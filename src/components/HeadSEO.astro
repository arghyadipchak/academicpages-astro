---
import { siteConfig } from '@data/siteConfig';
import type { CitationMetadata, SchemaOrgNode } from '@utils/seo';
import {
  buildPersonSchema,
  buildScholarlyArticleSchema,
  buildWebSiteSchema,
} from '@utils/seo';
import { resolveUrl } from '@utils/url';

export interface Props {
  title?: string;
  description?: string;
  articleDate?: Date;
  canonicalUrl?: string;
  image?: string;
  citation?: CitationMetadata;
  schemaNodes?: SchemaOrgNode[];
  ogType?: 'website' | 'article' | 'profile';
}

const {
  title,
  description = siteConfig.description,
  articleDate,
  canonicalUrl: propCanonicalUrl,
  image,
  citation,
  schemaNodes = [],
  ogType = articleDate ? 'article' : 'website',
} = Astro.props;

const xHandle = siteConfig.author.x
  ? siteConfig.author.x
      .replace(/^https?:\/\/(x|twitter)\.com\//, '')
      .replace(/^@/, '')
      .split('/')[0]
  : undefined;

const siteBase = Astro.site
  ? Astro.site.toString()
  : siteConfig.url
    ? new URL(siteConfig.url).origin
    : Astro.url.origin;

const canonicalUrl =
  propCanonicalUrl || new URL(Astro.url.pathname, siteBase).toString();

const pageTitle = title
  ? `${title} ${siteConfig.titleSeparator} ${siteConfig.title}`
  : siteConfig.title;

const pathname = Astro.url.pathname.replace(/^\/|\/$/g, '');
const ogFallback = pathname ? `/og/${pathname}.svg` : '/og/default.svg';
const effectiveImage = image || ogFallback;

const resolvedImage = effectiveImage.startsWith('http')
  ? effectiveImage
  : new URL(resolveUrl(effectiveImage), siteBase).toString();

const resolvedAvatar = siteConfig.author.avatar.startsWith('http')
  ? siteConfig.author.avatar
  : new URL(resolveUrl(siteConfig.author.avatar), siteBase).toString();

const personSchema = buildPersonSchema(
  siteBase,
  siteConfig.author,
  resolvedAvatar
);
const webSiteSchema = buildWebSiteSchema(siteBase);

const scholarlyArticleSchema = citation?.title
  ? buildScholarlyArticleSchema(
      canonicalUrl,
      siteBase,
      citation,
      description,
      resolvedImage
    )
  : null;

const jsonLdGraph: SchemaOrgNode[] = [
  webSiteSchema,
  personSchema,
  ...(scholarlyArticleSchema ? [scholarlyArticleSchema] : []),
  ...schemaNodes,
];
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta
  name="theme-color"
  content="#ffffff"
  media="(prefers-color-scheme: light)"
/>
<meta
  name="theme-color"
  content="#282c34"
  media="(prefers-color-scheme: dark)"
/>
<link rel="icon" type="image/x-icon" href={resolveUrl('/favicon.ico')} />
<link rel="icon" type="image/svg+xml" href={resolveUrl('/favicon.svg')} />
<link
  rel="icon"
  type="image/png"
  sizes="32x32"
  href={resolveUrl('/favicon-32x32.png')}
/>
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href={resolveUrl('/apple-touch-icon.png')}
/>
<link rel="manifest" href={resolveUrl('/site.webmanifest')} />
<link rel="canonical" href={canonicalUrl} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${siteConfig.title} Feed`}
  href={resolveUrl('/rss.xml')}
/>

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:alt" content={pageTitle} />
<meta property="og:locale" content={siteConfig.locale.replace('-', '_')} />
{
  articleDate && (
    <meta
      property="article:published_time"
      content={articleDate.toISOString()}
    />
  )
}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={resolvedImage} />
{
  xHandle && (
    <>
      <meta property="twitter:creator" content={`@${xHandle}`} />
      <meta property="twitter:site" content={`@${xHandle}`} />
    </>
  )
}

<!-- Google Scholar / Highwire Press Academic Meta Tags -->
{citation?.title && <meta name="citation_title" content={citation.title} />}
{
  (citation?.author || (citation?.title && siteConfig.author.name)) && (
    <meta
      name="citation_author"
      content={citation?.author || siteConfig.author.name}
    />
  )
}
{
  citation?.publicationDate && (
    <meta name="citation_publication_date" content={citation.publicationDate} />
  )
}
{
  citation?.journalTitle && (
    <meta name="citation_journal_title" content={citation.journalTitle} />
  )
}
{
  citation?.conferenceTitle && (
    <meta name="citation_conference_title" content={citation.conferenceTitle} />
  )
}
{citation?.pdfUrl && <meta name="citation_pdf_url" content={citation.pdfUrl} />}

<!-- Structured Data (JSON-LD) -->
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': jsonLdGraph,
  })}
/>
<!-- Dark Mode Initialization Script (Prevents flash of unstyled theme) -->
<script is:inline>
  function applyTheme() {
    const storedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia(
      '(prefers-color-scheme: dark)'
    ).matches;
    if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
      document.documentElement.setAttribute('data-theme', 'dark');
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.setAttribute('data-theme', 'light');
      document.documentElement.classList.remove('dark');
    }
  }

  applyTheme();
  document.addEventListener('astro:after-swap', applyTheme);
</script>
