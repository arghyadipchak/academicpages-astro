---
import { siteConfig } from '../data/siteConfig';
import { navigation } from '../data/navigation';
import ThemeToggle from './ThemeToggle.astro';
import { Icon } from 'astro-icon/components';

const currentPath = Astro.url.pathname;

function isSelected(url: string): boolean {
  if (url === '/' || url === '/index.html') {
    return currentPath === '/' || currentPath === '/index.html';
  }
  return currentPath.startsWith(url);
}
---

<header
  class="sticky top-0 z-50 h-16 w-full border-b border-(--global-border-color) bg-(--global-bg-color) shadow-xs transition-colors duration-200"
>
  <div
    class="mx-auto flex h-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <!-- Site Brand Title -->
    {
      () => {
        const isHome = isSelected('/');
        return (
          <a
            href="/"
            class:list={[
              'group relative inline-flex h-full items-center px-1 text-lg font-bold no-underline transition-all duration-150',
              isHome
                ? 'text-(--global-text-color)'
                : 'text-(--global-text-color) hover:text-(--global-base-color)',
            ]}
            aria-current={isHome ? 'page' : undefined}
          >
            <span>{siteConfig.title}</span>
            <span
              class:list={[
                'absolute right-1 bottom-2.5 left-1 h-[2.5px] rounded-full transition-all duration-200',
                isHome
                  ? 'bg-(--global-base-color) opacity-100 shadow-2xs'
                  : 'scale-x-0 bg-(--global-base-color) opacity-0 group-hover:scale-x-100 group-hover:opacity-40',
              ]}
              aria-hidden="true"
            />
          </a>
        );
      }
    }

    <!-- Desktop Navigation Links & Theme Toggle -->
    <nav
      class="hidden h-full items-center gap-6 md:flex"
      aria-label="Main Navigation"
    >
      <ul class="flex h-full items-center gap-1 text-sm font-medium">
        {
          navigation.map((item) => {
            const selected = isSelected(item.url);
            return (
              <li class="h-full">
                <a
                  href={item.url}
                  class:list={[
                    'group relative inline-flex h-full items-center px-3.5 text-sm no-underline transition-all duration-150',
                    selected
                      ? 'font-bold text-(--global-text-color)'
                      : 'font-medium text-(--global-masthead-link-color) hover:bg-(--global-footer-bg-color)/50 hover:text-(--global-base-color)',
                  ]}
                  aria-current={selected ? 'page' : undefined}
                >
                  <span>{item.title}</span>
                  {/* Floating Aesthetic Indicator Bar */}
                  <span
                    class:list={[
                      'absolute right-2 bottom-2.5 left-2 h-[2.5px] rounded-full transition-all duration-200',
                      selected
                        ? 'bg-(--global-base-color) opacity-100 shadow-2xs'
                        : 'scale-x-0 bg-(--global-base-color) opacity-0 group-hover:scale-x-100 group-hover:opacity-40',
                    ]}
                    aria-hidden="true"
                  />
                </a>
              </li>
            );
          })
        }
      </ul>

      <div
        class="flex items-center gap-3 border-l border-(--global-border-color) pl-4"
      >
        <button
          type="button"
          class="search-trigger-btn inline-flex items-center gap-1.5 rounded-md border border-(--global-border-color) bg-(--global-bg-color) px-2.5 py-1 text-xs text-(--global-text-color-light) shadow-2xs transition hover:border-(--global-link-color) hover:text-(--global-text-color)"
          aria-label="Search site"
        >
          <Icon name="fa6-solid:magnifying-glass" class="h-3 w-3" />
          <span class="hidden lg:inline">Search...</span>
          <kbd
            class="hidden rounded bg-neutral-200 px-1 py-0.5 font-mono text-[10px] text-neutral-600 lg:inline-block dark:bg-neutral-800 dark:text-neutral-300"
            >⌘K</kbd
          >
        </button>
        <ThemeToggle />
      </div>
    </nav>

    <!-- Mobile Nav Controls -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        type="button"
        class="search-trigger-btn inline-flex items-center justify-center rounded-md p-2 text-(--global-text-color) hover:bg-(--global-footer-bg-color) focus:outline-none"
        aria-label="Open search"
      >
        <Icon name="fa6-solid:magnifying-glass" class="h-4 w-4" />
      </button>
      <ThemeToggle />
      <button
        id="mobile-nav-toggle"
        type="button"
        class="group relative inline-flex h-9 w-9 items-center justify-center rounded-md text-(--global-text-color) hover:bg-(--global-footer-bg-color) focus:outline-none"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <span class="sr-only">Toggle navigation menu</span>
        <div class="relative flex h-5 w-5 items-center justify-center">
          <Icon
            name="fa6-solid:bars"
            class="mobile-menu-open-icon absolute h-5 w-5 transform transition-all duration-300"
            aria-hidden="true"
          />
          <Icon
            name="fa6-solid:xmark"
            class="mobile-menu-close-icon absolute h-5 w-5 transform transition-all duration-300"
            aria-hidden="true"
          />
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-(--global-border-color) bg-(--global-bg-color) px-4 pt-2 pb-4 shadow-md md:hidden"
  >
    <ul class="flex flex-col space-y-2">
      {
        navigation.map((item) => {
          const selected = isSelected(item.url);
          return (
            <li>
              <a
                href={item.url}
                class:list={[
                  'flex items-center justify-between rounded-md px-3 py-2 text-base font-medium transition-colors',
                  selected
                    ? 'border-l-4 border-(--global-base-color) bg-(--global-footer-bg-color) font-bold text-(--global-base-color)'
                    : 'text-(--global-masthead-link-color) hover:bg-(--global-footer-bg-color) hover:text-(--global-base-color)',
                ]}
                aria-current={selected ? 'page' : undefined}
              >
                <span>{item.title}</span>
                {selected && (
                  <span class="h-2 w-2 rounded-full bg-(--global-base-color)" />
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const menu = document.getElementById('mobile-menu');

    if (!toggleBtn || !menu) return;

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
