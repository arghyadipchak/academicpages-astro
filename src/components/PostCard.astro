---
import { Icon } from 'astro-icon/components';

import { formatDate, toIsoDateString } from '@utils/date';
import { parseInline } from '@utils/marked';
import { resolveUrl } from '@utils/url';

export interface Props {
  title: string;
  url: string;
  description?: string;
  date?: Date;
  readTime?: string;
  image?: string;
}

const { title, url, description, date, readTime, image } = Astro.props;

const formattedDate = formatDate(date);
---

<div class="archive__item border-b border-(--global-border-color) py-4 first:pt-0 last:border-b-0">
  <article itemscope itemtype="http://schema.org/CreativeWork">
    <h3 class="text-lg font-bold tracking-tight" itemprop="headline">
      <a
        href={url}
        class="text-(--global-link-color) hover:text-(--global-link-color-hover) hover:underline"
        set:html={parseInline(title)}
      />
    </h3>

    {(formattedDate || readTime) && (
      <div class="mt-1 flex flex-wrap items-center gap-3 text-xs text-(--global-text-color-light)">
        {formattedDate && (
          <p class="archive-date-line inline-flex items-center gap-1.5 leading-none">
            <Icon name="fa6-solid:calendar" class="h-3 w-3 shrink-0" />
            <time datetime={toIsoDateString(date)}>{formattedDate}</time>
          </p>
        )}
        {readTime && (
          <p class="archive-date-line inline-flex items-center gap-1.5 leading-none">
            <Icon name="fa6-solid:clock" class="h-3 w-3 shrink-0" />
            <span>{readTime}</span>
          </p>
        )}
      </div>
    )}

    {description && (
      <p
        class="mt-2 text-sm text-(--global-text-color)"
        itemprop="description"
        set:html={parseInline(description)}
      />
    )}

    {image && (
      <div class="mt-3 overflow-hidden rounded-md">
        <img
          src={resolveUrl(image)}
          alt={title}
          class="h-auto max-h-60 w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    )}
  </article>
</div>
