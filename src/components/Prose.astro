---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={[
    'prose max-w-none text-(--global-text-color)',
    'prose-headings:text-(--global-text-color)',
    'prose-a:text-(--global-link-color) hover:prose-a:text-(--global-link-color-hover) hover:prose-a:underline',
    'prose-strong:text-(--global-text-color)',
    'prose-img:rounded-md',
    className,
  ]}
>
  <slot />
</div>
