---
import { parseInline } from '@utils/marked';

export interface Props {
  title: string;
  url: string;
  description?: string;
  year?: number;
  semester?: string;
  type?: string;
  venue?: string;
}

const { title, url, description, year, semester, type, venue } = Astro.props;

const termDisplay =
  semester && year
    ? `${semester} ${year}`
    : semester || (year ? `${year}` : '');
---

<div
  class="archive__item border-b border-(--global-border-color) py-4 first:pt-0 last:border-b-0"
>
  <article itemscope itemtype="http://schema.org/CreativeWork">
    <h3 class="text-lg font-bold tracking-tight" itemprop="headline">
      <a
        href={url}
        class="text-(--global-link-color) hover:text-(--global-link-color-hover) hover:underline"
        set:html={parseInline(title)}
      />
    </h3>

    {
      (type || venue || termDisplay) && (
        <p class="mt-1 text-sm text-(--global-text-color-light)">
          {type ? `${type}, ` : ''}
          {venue ? <em>{venue}</em> : ''}
          {termDisplay ? `, ${termDisplay}` : ''}
        </p>
      )
    }

    {
      description && (
        <p
          class="mt-2 text-sm text-(--global-text-color)"
          itemprop="description"
          set:html={parseInline(description)}
        />
      )
    }
  </article>
</div>
