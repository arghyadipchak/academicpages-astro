---
import { Icon } from 'astro-icon/components';

import { siteConfig } from '@data/siteConfig';
import { darkThemes, lightThemes } from '@data/themes';

const defaultLight =
  typeof siteConfig.theme?.light === 'string'
    ? siteConfig.theme.light
    : 'default';
const defaultDark =
  typeof siteConfig.theme?.dark === 'string'
    ? siteConfig.theme.dark
    : 'default';
---

<div
  class="theme-picker relative inline-flex items-center"
  data-default-light={defaultLight}
  data-default-dark={defaultDark}
>
  <button
    type="button"
    class="theme-picker-btn inline-flex cursor-pointer items-center justify-center p-1.5 text-(--global-text-color-light) transition-colors hover:text-(--global-text-color) focus:outline-none"
    aria-label="Customize color theme"
    aria-expanded="false"
    aria-haspopup="dialog"
    title="Customize color theme"
  >
    <Icon name="fa6-solid:palette" class="h-4 w-4" aria-hidden="true" />
  </button>

  <div
    class="theme-picker-popover fixed top-16 right-4 z-50 hidden w-80 max-w-[calc(100vw-2rem)] rounded-lg border border-(--global-border-color) bg-(--global-bg-color) p-3 shadow-lg sm:absolute sm:top-full sm:right-0 sm:mt-2"
    role="dialog"
    aria-label="Theme presets"
  >
    <div
      class="mb-2.5 flex items-center gap-1 rounded-md bg-(--global-footer-bg-color) p-1 text-xs font-medium"
      role="tablist"
      aria-label="Theme mode"
    >
      <button
        type="button"
        role="tab"
        data-tab-mode="light"
        aria-selected="true"
        class="theme-picker-tab flex-1 cursor-pointer rounded px-2 py-1 text-center transition-colors"
      >
        Light ({Object.keys(lightThemes).length})
      </button>
      <button
        type="button"
        role="tab"
        data-tab-mode="dark"
        aria-selected="false"
        class="theme-picker-tab flex-1 cursor-pointer rounded px-2 py-1 text-center transition-colors"
      >
        Dark ({Object.keys(darkThemes).length})
      </button>
    </div>

    <div
      data-panel-mode="light"
      class="theme-picker-panel grid max-h-[65vh] scrollbar-thin [scrollbar-color:var(--global-dark-border-color)_transparent] grid-cols-2 gap-1.5 overflow-y-auto [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-(--global-dark-border-color) [&::-webkit-scrollbar-track]:bg-transparent"
    >
      {
        Object.entries(lightThemes).map(([name, p]) => (
          <button
            type="button"
            data-preset-mode="light"
            data-preset-name={name}
            class="theme-preset-option flex cursor-pointer items-center gap-2 rounded-md border border-(--global-border-color) px-2 py-1.5 text-left text-xs text-(--global-text-color) transition hover:border-(--global-base-color)"
          >
            <span
              class="flex shrink-0 items-center -space-x-1"
              aria-hidden="true"
            >
              <span
                class="h-3 w-3 rounded-full border border-black/15"
                style={`background-color:${p.bg}`}
              />
              <span
                class="h-3 w-3 rounded-full border border-black/15"
                style={`background-color:${p.base}`}
              />
              <span
                class="h-3 w-3 rounded-full border border-black/15"
                style={`background-color:${p.text}`}
              />
            </span>
            <span class="truncate font-medium">{name}</span>
          </button>
        ))
      }
    </div>

    <div
      data-panel-mode="dark"
      class="theme-picker-panel hidden max-h-[65vh] scrollbar-thin [scrollbar-color:var(--global-dark-border-color)_transparent] grid-cols-2 gap-1.5 overflow-y-auto [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-(--global-dark-border-color) [&::-webkit-scrollbar-track]:bg-transparent"
    >
      {
        Object.entries(darkThemes).map(([name, p]) => (
          <button
            type="button"
            data-preset-mode="dark"
            data-preset-name={name}
            class="theme-preset-option flex cursor-pointer items-center gap-2 rounded-md border border-(--global-border-color) px-2 py-1.5 text-left text-xs text-(--global-text-color) transition hover:border-(--global-base-color)"
          >
            <span
              class="flex shrink-0 items-center -space-x-1"
              aria-hidden="true"
            >
              <span
                class="h-3 w-3 rounded-full border border-white/20"
                style={`background-color:${p.bg}`}
              />
              <span
                class="h-3 w-3 rounded-full border border-white/20"
                style={`background-color:${p.base}`}
              />
              <span
                class="h-3 w-3 rounded-full border border-white/20"
                style={`background-color:${p.text}`}
              />
            </span>
            <span class="truncate font-medium">{name}</span>
          </button>
        ))
      }
    </div>

    <div
      class="mt-2.5 flex items-center justify-between gap-2 border-t border-(--global-border-color) pt-2 text-[11px]"
    >
      <code
        class="theme-picker-summary truncate font-mono text-(--global-text-color-light)"
      ></code>
      <div class="flex shrink-0 items-center gap-1.5">
        <button
          type="button"
          class="theme-picker-reset cursor-pointer rounded border border-(--global-border-color) px-1.5 py-0.5 text-(--global-text-color-light) transition hover:text-(--global-text-color)"
        >
          Reset
        </button>
        <button
          type="button"
          class="theme-picker-copy cursor-pointer rounded bg-(--global-base-color) px-2 py-0.5 font-medium text-(--global-bg-color) transition hover:opacity-90"
        >
          Copy config
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  if (!window.__themePickerInit) {
    window.__themePickerInit = true;

    const getActivePresets = (picker) => ({
      light:
        localStorage.getItem('theme-light-preset') ||
        picker.dataset.defaultLight ||
        'default',
      dark:
        localStorage.getItem('theme-dark-preset') ||
        picker.dataset.defaultDark ||
        'default',
    });

    const syncPickerState = (activeTabMode) => {
      const currentTheme =
        document.documentElement.getAttribute('data-theme') === 'dark'
          ? 'dark'
          : 'light';
      const tabMode = activeTabMode || currentTheme;

      document.querySelectorAll('.theme-picker').forEach((picker) => {
        const { light, dark } = getActivePresets(picker);

        picker.querySelectorAll('.theme-picker-tab').forEach((tab) => {
          const isSelected = tab.dataset.tabMode === tabMode;
          tab.setAttribute('aria-selected', String(isSelected));
          tab.classList.toggle('bg-(--global-bg-color)', isSelected);
          tab.classList.toggle('text-(--global-text-color)', isSelected);
          tab.classList.toggle('shadow-2xs', isSelected);
          tab.classList.toggle('text-(--global-text-color-light)', !isSelected);
        });

        picker.querySelectorAll('.theme-picker-panel').forEach((panel) => {
          const isActive = panel.dataset.panelMode === tabMode;
          panel.classList.toggle('hidden', !isActive);
          panel.classList.toggle('grid', isActive);
        });

        picker.querySelectorAll('.theme-preset-option').forEach((opt) => {
          const mode = opt.dataset.presetMode;
          const name = opt.dataset.presetName;
          const isCurrent =
            (mode === 'light' && name === light) ||
            (mode === 'dark' && name === dark);
          opt.setAttribute('aria-pressed', String(isCurrent));
          opt.classList.toggle('border-(--global-base-color)', isCurrent);
          opt.classList.toggle('bg-(--global-footer-bg-color)', isCurrent);
          opt.classList.toggle('border-(--global-border-color)', !isCurrent);
        });

        const summary = picker.querySelector('.theme-picker-summary');
        if (summary) summary.textContent = `${light} / ${dark}`;
      });
    };

    const closeAllPickers = () => {
      document.querySelectorAll('.theme-picker').forEach((picker) => {
        picker.querySelector('.theme-picker-popover')?.classList.add('hidden');
        picker
          .querySelector('.theme-picker-btn')
          ?.setAttribute('aria-expanded', 'false');
      });
    };

    const setupThemePicker = () => {
      syncPickerState();

      document.querySelectorAll('.theme-picker').forEach((picker) => {
        const btn = picker.querySelector('.theme-picker-btn');
        const popover = picker.querySelector('.theme-picker-popover');
        if (!btn || !popover) return;

        btn.onclick = (e) => {
          e.stopPropagation();
          const isHidden = popover.classList.contains('hidden');
          closeAllPickers();
          if (isHidden) {
            syncPickerState();
            popover.classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
          }
        };

        popover.onclick = (e) => e.stopPropagation();

        picker.querySelectorAll('.theme-picker-tab').forEach((tab) => {
          tab.onclick = () => syncPickerState(tab.dataset.tabMode);
        });

        picker.querySelectorAll('.theme-preset-option').forEach((opt) => {
          opt.onclick = () => {
            const mode = opt.dataset.presetMode;
            const name = opt.dataset.presetName;
            if (!mode || !name) return;
            localStorage.setItem(`theme-${mode}-preset`, name);
            window.__applyTheme?.(mode);
            syncPickerState(mode);
          };
        });

        const resetBtn = picker.querySelector('.theme-picker-reset');
        if (resetBtn) {
          resetBtn.onclick = () => {
            localStorage.removeItem('theme-light-preset');
            localStorage.removeItem('theme-dark-preset');
            const current =
              document.documentElement.getAttribute('data-theme') || 'light';
            window.__applyTheme?.(current);
            syncPickerState();
          };
        }

        const copyBtn = picker.querySelector('.theme-picker-copy');
        if (copyBtn) {
          copyBtn.onclick = async () => {
            const { light, dark } = getActivePresets(picker);
            const snippet = `theme: {\n  light: '${light}',\n  dark: '${dark}',\n},`;
            try {
              await navigator.clipboard.writeText(snippet);
              const prev = copyBtn.textContent;
              copyBtn.textContent = 'Copied!';
              setTimeout(() => {
                copyBtn.textContent = prev;
              }, 1500);
            } catch {
              // Ignore clipboard errors in non-secure contexts
            }
          };
        }
      });
    };

    document.addEventListener('click', closeAllPickers);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAllPickers();
    });
    document.addEventListener('theme-change', () => syncPickerState());
    document.addEventListener('astro:page-load', setupThemePicker);
  }
</script>
