---
import { Icon } from 'astro-icon/components';
---

<button
  type="button"
  class="theme-toggle-btn inline-flex cursor-pointer items-center justify-center p-1.5 text-(--global-text-color-light) transition-colors hover:text-(--global-text-color) focus:outline-none"
  aria-label="Toggle theme"
  title="Toggle theme"
>
  <span class="dark:hidden">
    <Icon name="fa6-solid:moon" class="h-4 w-4" aria-hidden="true" />
  </span>
  <span class="hidden dark:inline">
    <Icon
      name="fa6-solid:sun"
      class="h-4 w-4 text-amber-400"
      aria-hidden="true"
    />
  </span>
</button>

<script>
  import { announce } from '@utils/a11y';

  function updateThemeToggleLabels(theme: string) {
    const isDark = theme === 'dark';
    const label = isDark ? 'Switch to light theme' : 'Switch to dark theme';
    document.querySelectorAll('.theme-toggle-btn').forEach((btn) => {
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
    });
  }

  function setupThemeToggle() {
    const currentTheme =
      document.documentElement.getAttribute('data-theme') || 'light';
    updateThemeToggleLabels(currentTheme);

    document
      .querySelectorAll<HTMLButtonElement>('.theme-toggle-btn')
      .forEach((btn) => {
        btn.onclick = () => {
          const isDark =
            document.documentElement.getAttribute('data-theme') === 'dark';
          const nextTheme = isDark ? 'light' : 'dark';
          (
            window as Window & { __applyTheme?: (t: string) => string }
          ).__applyTheme?.(nextTheme);
          announce(`Color theme set to ${nextTheme}`);
        };
      });
  }

  document.addEventListener('theme-change', (e) => {
    updateThemeToggleLabels((e as CustomEvent<{ theme: string }>).detail.theme);
  });
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
