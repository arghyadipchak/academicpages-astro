---
import BaseLayout from './BaseLayout.astro';
import AuthorProfile from '../components/AuthorProfile.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { renderMath } from '../utils/math';

export interface Props {
  title: string;
  description?: string;
  author_profile?: boolean;
}

const { title, description, author_profile = true } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Left Sidebar: Author Profile -->
      {
        author_profile && (
          <aside class="lg:col-span-3">
            <div class="sticky top-24">
              <AuthorProfile />
            </div>
          </aside>
        )
      }

      <!-- Main Content Column -->
      <main
        class:list={[
          author_profile ? 'lg:col-span-9' : 'lg:col-span-12',
          'min-w-0',
        ]}
      >
        <Breadcrumbs />

        <header class="mb-6 border-b border-(--global-border-color) pb-3">
          <h1
            class="text-2xl font-bold tracking-tight text-(--global-text-color) sm:text-3xl"
            set:html={renderMath(title)}
          />
          {
            description && (
              <p class="mt-2 text-sm text-(--global-text-color-light)">
                {description}
              </p>
            )
          }
        </header>

        <section class="archive-content">
          <slot />
        </section>
      </main>
    </div>
  </div>
</BaseLayout>
