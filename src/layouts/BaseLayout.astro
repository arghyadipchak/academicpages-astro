---
import '@styles/global.css';

import { ClientRouter, fade } from 'astro:transitions';

import BackToTop from '@components/BackToTop.astro';
import Footer from '@components/Footer.astro';
import HeadSEO from '@components/HeadSEO.astro';
import Masthead from '@components/Masthead.astro';
import ProseEnhancer from '@components/ProseEnhancer.astro';
import SearchModal from '@components/SearchModal.astro';

import { siteConfig } from '@data/siteConfig';
import type { CitationMetadata, SchemaOrgNode } from '@utils/seo';

export interface Props {
  title?: string;
  description?: string;
  articleDate?: Date;
  canonicalUrl?: string;
  image?: string;
  citation?: CitationMetadata;
  schemaNodes?: SchemaOrgNode[];
  ogType?: 'website' | 'article' | 'profile';
}

const {
  title,
  description,
  articleDate,
  canonicalUrl,
  image,
  citation,
  schemaNodes,
  ogType,
} = Astro.props;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <HeadSEO
      title={title}
      description={description}
      articleDate={articleDate}
      canonicalUrl={canonicalUrl}
      image={image}
      citation={citation}
      schemaNodes={schemaNodes}
      ogType={ogType}
    />
    <ClientRouter fallback="swap" />
  </head>
  <body class="flex min-h-screen flex-col bg-(--global-bg-color) text-(--global-text-color) antialiased transition-colors duration-200">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-(--global-base-color) focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white focus:shadow-lg focus:outline-none"
    >
      Skip to content
    </a>
    <div
      id="reading-progress"
      class="fixed top-0 left-0 z-60 h-[3px] w-0 bg-(--global-base-color) transition-[width] duration-75 ease-out"
      aria-hidden="true"
    ></div>
    <Masthead />
    <div
      id="main-content"
      class="flex-1"
      transition:animate={fade({ duration: '0.08s' })}
    >
      <slot />
    </div>
    <Footer />
    <BackToTop />
    <ProseEnhancer />
    <SearchModal transition:persist="search-modal" />
    <div
      id="a11y-announcer"
      class="sr-only"
      aria-live="polite"
      aria-atomic="true"
      transition:persist="a11y-announcer"
    ></div>
  </body>
</html>
