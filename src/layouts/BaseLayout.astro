---
import '../styles/global.css';
import HeadSEO from '../components/HeadSEO.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import ProseEnhancer from '../components/ProseEnhancer.astro';
import SearchModal from '../components/SearchModal.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: Date;
  canonicalUrl?: string;
  citation?: {
    title?: string;
    author?: string;
    publicationDate?: string;
    journalTitle?: string;
    pdfUrl?: string;
  };
}

const { title, description, image, articleDate, canonicalUrl, citation } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <HeadSEO
      title={title}
      description={description}
      image={image}
      articleDate={articleDate}
      canonicalUrl={canonicalUrl}
      citation={citation}
    />
  </head>
  <body
    class="flex min-h-screen flex-col bg-(--global-bg-color) text-(--global-text-color) antialiased transition-colors duration-200"
  >
    <Masthead />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
    <ProseEnhancer />
    <SearchModal />
  </body>
</html>
