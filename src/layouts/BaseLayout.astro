---
import '@styles/global.css';

import Footer from '@components/Footer.astro';
import HeadSEO from '@components/HeadSEO.astro';
import Masthead from '@components/Masthead.astro';
import ProseEnhancer from '@components/ProseEnhancer.astro';
import SearchModal from '@components/SearchModal.astro';

import { siteConfig } from '@data/siteConfig';

export interface Props {
  title?: string;
  description?: string;
  articleDate?: Date;
  canonicalUrl?: string;
  image?: string;
  citation?: {
    title?: string;
    author?: string;
    publicationDate?: string;
    journalTitle?: string;
    pdfUrl?: string;
  };
}

const { title, description, articleDate, canonicalUrl, image, citation } =
  Astro.props;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <HeadSEO
      title={title}
      description={description}
      articleDate={articleDate}
      canonicalUrl={canonicalUrl}
      image={image}
      citation={citation}
    />
  </head>
  <body
    class="flex min-h-screen flex-col bg-(--global-bg-color) text-(--global-text-color) antialiased transition-colors duration-200"
  >
    <Masthead />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
    <ProseEnhancer />
    <SearchModal />
  </body>
</html>
