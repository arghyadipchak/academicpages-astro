---
import BaseLayout from '@layouts/BaseLayout.astro';
import ActionBadges from '@components/ActionBadges.astro';
import AuthorProfile from '@components/AuthorProfile.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Prose from '@components/Prose.astro';
import TableOfContents from '@components/TableOfContents.astro';

import { parseInline } from '@utils/marked';

export interface Props {
  title: string;
  description?: string;
  date?: Date;
  tags?: string[];
  citation?: string;
  citationMetadata?: {
    title?: string;
    author?: string;
    publicationDate?: string;
    journalTitle?: string;
    pdfUrl?: string;
  };
  pdfUrl?: string;
  paperUrl?: string;
  slidesUrl?: string;
  codeUrl?: string;
  bibtex?: string;
  authorProfile?: boolean;
  toc?: boolean;
  image?: string;
  transitionName?: string;
}

const {
  title,
  description,
  date,
  tags = [],
  citation,
  citationMetadata,
  pdfUrl: rawPdfUrl,
  paperUrl,
  slidesUrl,
  codeUrl,
  bibtex,
  authorProfile = true,
  toc = true,
  image,
  transitionName,
} = Astro.props;

const pdfUrl = rawPdfUrl ?? paperUrl;
---

<BaseLayout
  title={title}
  description={description}
  articleDate={date}
  image={image}
  citation={citationMetadata}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Left Sidebar: Author Profile -->
      {authorProfile && (
        <aside class="lg:col-span-3">
          <div class="sticky top-24">
            <AuthorProfile />
          </div>
        </aside>
      )}

      <!-- Main Content Column -->
      <main
        class:list={[
          authorProfile ? 'lg:col-span-9' : 'lg:col-span-12',
          'min-w-0',
        ]}
      >
        <Breadcrumbs />

        <article
          class="page"
          itemscope
          itemtype="http://schema.org/CreativeWork"
        >
          <header class="mb-6">
            <h1
              class="text-2xl font-bold tracking-tight text-(--global-text-color) sm:text-3xl"
              itemprop="headline"
              transition:name={transitionName}
              set:html={parseInline(title)}
            />
            <slot name="header-metadata" />
          </header>

          {toc !== false && <TableOfContents />}

          <!-- Main Article Body -->
          <Prose>
            <slot />
          </Prose>

          <!-- Citation and downloads for publications -->
          {(citation || pdfUrl || slidesUrl || codeUrl || bibtex) && (
            <div class="mt-6 border-t border-(--global-border-color) pt-4 text-xs text-(--global-text-color-light)">
              {citation && (
                <p class="mb-2">
                  <strong>Recommended citation:</strong>{' '}
                  <span set:html={parseInline(citation)} />
                </p>
              )}
              <ActionBadges
                pdfUrl={pdfUrl}
                slidesUrl={slidesUrl}
                codeUrl={codeUrl}
                bibtex={bibtex}
              />
            </div>
          )}

          {/* Tags footer */}
          {tags.length > 0 && (
            <footer class="mt-8 border-t border-(--global-border-color) pt-4 text-xs text-(--global-text-color-light)">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-semibold">Tags:</span>
                {tags.map((tag) => (
                  <span class="rounded-sm bg-(--global-footer-bg-color) px-2 py-0.5">
                    {tag}
                  </span>
                ))}
              </div>
            </footer>
          )}
        </article>
      </main>
    </div>
  </div>
</BaseLayout>
