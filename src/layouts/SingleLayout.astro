---
import { Icon } from 'astro-icon/components';

import ActionBadges from '../components/ActionBadges.astro';
import AuthorProfile from '../components/AuthorProfile.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Prose from '../components/Prose.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { siteConfig } from '../data/siteConfig';
import { formatDate, formatYear, toIsoDateString } from '../utils/date';
import { parseInline } from '../utils/marked';
import { resolveUrl } from '../utils/url';
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description?: string;
  date?: Date;
  modified?: Date;
  readTime?: string;
  tags?: string[];
  type?: string;
  venue?: string;
  location?: string;
  citation?: string;
  pdfUrl?: string;
  paperUrl?: string;
  slidesUrl?: string;
  codeUrl?: string;
  bibtex?: string;
  collection?: string;
  authorProfile?: boolean;
  toc?: boolean;
  image?: string;
}

const {
  title,
  description,
  date,
  modified,
  readTime,
  tags = [],
  type,
  venue,
  location,
  citation,
  pdfUrl: rawPdfUrl,
  paperUrl,
  slidesUrl,
  codeUrl,
  bibtex,
  collection,
  authorProfile = true,
  toc = true,
  image,
} = Astro.props;

const pdfUrl = rawPdfUrl ?? paperUrl;
const formattedDate = formatDate(date);
const formattedYear = formatYear(date);

const citationMetadata =
  collection === 'publications'
    ? {
        title,
        author: siteConfig.author.name,
        publicationDate: toIsoDateString(date),
        journalTitle: venue,
        pdfUrl: pdfUrl
          ? pdfUrl.startsWith('http')
            ? pdfUrl
            : new URL(
                resolveUrl(pdfUrl),
                Astro.site
                  ? Astro.site.toString()
                  : siteConfig.url
                    ? new URL(siteConfig.url).origin
                    : Astro.url.origin
              ).toString()
          : undefined,
      }
    : undefined;
---

<BaseLayout
  title={title}
  description={description}
  articleDate={date}
  image={image}
  citation={citationMetadata}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Left Sidebar: Author Profile -->
      {
        authorProfile && (
          <aside class="lg:col-span-3">
            <div class="sticky top-24">
              <AuthorProfile />
            </div>
          </aside>
        )
      }

      <!-- Main Content Column -->
      <main
        class:list={[
          authorProfile ? 'lg:col-span-9' : 'lg:col-span-12',
          'min-w-0',
        ]}
      >
        <Breadcrumbs />

        <article
          class="page"
          itemscope
          itemtype="http://schema.org/CreativeWork"
        >
          <header class="mb-6">
            <h1
              class="text-2xl font-bold tracking-tight text-(--global-text-color) sm:text-3xl"
              itemprop="headline"
              set:html={parseInline(title)}
            />

            {/* Teaching metadata */}
            {
              collection === 'teaching' && venue && formattedYear && (
                <p class="mt-2 text-sm text-(--global-text-color-light)">
                  {type ? `${type}, ` : ''}
                  <em>{venue}</em>, {formattedYear}
                </p>
              )
            }

            {/* Publication metadata */}
            {
              collection === 'publications' && venue && (
                <p class="mt-2 text-sm text-(--global-text-color-light)">
                  Published in <em>{venue}</em>
                  {formattedYear ? `, ${formattedYear}` : ''}
                </p>
              )
            }

            {/* Talk metadata */}
            {
              collection === 'talks' && (
                <div class="mt-2 space-y-1 text-sm text-(--global-text-color-light)">
                  {formattedDate && (
                    <p class="archive-date-line inline-flex items-center gap-1.5 leading-none font-medium">
                      <Icon
                        name="fa6-solid:calendar"
                        class="h-3.5 w-3.5 shrink-0"
                      />
                      <span>Date: {formattedDate}</span>
                    </p>
                  )}
                  {(type || venue || location) && (
                    <p>
                      {type} {venue ? `at ${venue}` : ''}
                      {location ? `, ${location}` : ''}
                    </p>
                  )}
                </div>
              )
            }

            {/* Blog Post publish date & read time */}
            {
              collection === 'blog' && (formattedDate || readTime) && (
                <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-(--global-text-color-light)">
                  {formattedDate && (
                    <p class="inline-flex items-center gap-1.5 leading-none">
                      <Icon
                        name="fa6-solid:calendar"
                        class="h-3.5 w-3.5 shrink-0"
                      />
                      <span>
                        <strong>Published:</strong> {formattedDate}
                      </span>
                      {modified && (
                        <span class="ml-2">
                          (Updated: {formatDate(modified)})
                        </span>
                      )}
                    </p>
                  )}
                  {readTime && (
                    <p class="inline-flex items-center gap-1.5 leading-none">
                      <Icon
                        name="fa6-solid:clock"
                        class="h-3.5 w-3.5 shrink-0"
                      />
                      <span>{readTime}</span>
                    </p>
                  )}
                </div>
              )
            }
          </header>

          {toc !== false && <TableOfContents />}

          <!-- Main Article Body -->
          <Prose>
            <slot />
          </Prose>

          <!-- Citation and downloads for publications -->
          {
            (citation || pdfUrl || slidesUrl || codeUrl || bibtex) && (
              <div class="mt-6 border-t border-(--global-border-color) pt-4 text-xs text-(--global-text-color-light)">
                {citation && (
                  <p class="mb-2">
                    <strong>Recommended citation:</strong>{' '}
                    <span set:html={parseInline(citation)} />
                  </p>
                )}
                <ActionBadges
                  pdfUrl={pdfUrl}
                  slidesUrl={slidesUrl}
                  codeUrl={codeUrl}
                  bibtex={bibtex}
                />
              </div>
            )
          }

          {/* Tags footer */}
          {
            tags.length > 0 && (
              <footer class="mt-8 border-t border-(--global-border-color) pt-4 text-xs text-(--global-text-color-light)">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-semibold">Tags:</span>
                  {tags.map((tag) => (
                    <span class="rounded-sm bg-(--global-footer-bg-color) px-2 py-0.5">
                      {tag}
                    </span>
                  ))}
                </div>
              </footer>
            )
          }
        </article>
      </main>
    </div>
  </div>
</BaseLayout>
