---
import { Icon } from 'astro-icon/components';

import PageLayout from '@layouts/PageLayout.astro';

import { resolveUrl } from '@utils/url';
---

<PageLayout title="Page Not Found">
  <div class="space-y-6 py-8">
    <p class="text-lg text-(--global-text-color)">
      Sorry, but the page you were trying to view does not exist.
    </p>
    <div class="flex flex-wrap items-center gap-4">
      <button
        type="button"
        class="search-trigger-btn inline-flex cursor-pointer items-center gap-2 rounded-md bg-(--global-base-color) px-4 py-2 text-sm font-semibold text-white shadow-xs hover:opacity-90 focus:outline-none"
      >
        <Icon name="fa6-solid:magnifying-glass" class="h-3.5 w-3.5" />
        Search this site
      </button>
      <a
        href={resolveUrl('/')}
        class="inline-flex items-center gap-2 text-sm font-medium text-(--global-link-color) hover:underline"
      >
        &larr; Return to Homepage
      </a>
    </div>
  </div>
</PageLayout>
