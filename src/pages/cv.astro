---
import { getCollection } from 'astro:content';
import SingleLayout from '../layouts/SingleLayout.astro';
import { renderMath } from '../utils/math';
import { resolveUrl } from '../utils/url';

const publications = await getCollection('publications');
publications.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const talks = await getCollection('talks');
talks.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const teaching = await getCollection('teaching');
teaching.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function getPubUrl(pub: (typeof publications)[0]): string {
  return resolveUrl(
    pub.data.permalink || `/publications/${pub.id.replace(/\.md$/, '')}/`
  );
}

function getTalkUrl(talk: (typeof talks)[0]): string {
  return resolveUrl(
    talk.data.permalink || `/talks/${talk.id.replace(/\.md$/, '')}/`
  );
}

function getTeachingUrl(item: (typeof teaching)[0]): string {
  return resolveUrl(
    item.data.permalink || `/teaching/${item.id.replace(/\.md$/, '')}/`
  );
}
---

<SingleLayout title="CV">
  <div class="cv-content space-y-6">
    <section>
      <h2
        class="border-b border-(--global-border-color) pb-1 text-xl font-bold text-(--global-text-color)"
      >
        Education
      </h2>
      <ul
        class="mt-3 list-disc space-y-1 pl-5 text-sm text-(--global-text-color)"
      >
        <li>Ph.D in Computer Science, GitHub University, 2018 (expected)</li>
        <li>M.S. in Software Systems, GitHub University, 2014</li>
        <li>B.S. in Computer Science, GitHub University, 2012</li>
      </ul>
    </section>

    <section>
      <h2
        class="border-b border-(--global-border-color) pb-1 text-xl font-bold text-(--global-text-color)"
      >
        Work experience
      </h2>
      <ul
        class="mt-3 list-disc space-y-2 pl-5 text-sm text-(--global-text-color)"
      >
        <li>
          <strong>Spring 2024: Academic Pages Collaborator</strong>
          <ul class="list-circle space-y-0.5 pl-5">
            <li>GitHub University</li>
            <li>Duties include: Updates and improvements to template</li>
            <li>Supervisor: The Users</li>
          </ul>
        </li>
        <li>
          <strong>Fall 2015: Research Assistant</strong>
          <ul class="list-circle space-y-0.5 pl-5">
            <li>GitHub University</li>
            <li>Duties included: Merging pull requests</li>
            <li>Supervisor: Professor Hub</li>
          </ul>
        </li>
        <li>
          <strong>Summer 2015: Research Assistant</strong>
          <ul class="list-circle space-y-0.5 pl-5">
            <li>GitHub University</li>
            <li>Duties included: Tagging issues</li>
            <li>Supervisor: Professor Git</li>
          </ul>
        </li>
      </ul>
    </section>

    <section>
      <h2
        class="border-b border-(--global-border-color) pb-1 text-xl font-bold text-(--global-text-color)"
      >
        Skills
      </h2>
      <ul
        class="mt-3 list-disc space-y-1 pl-5 text-sm text-(--global-text-color)"
      >
        <li>Skill 1</li>
        <li>
          Skill 2
          <ul class="list-circle space-y-0.5 pl-5">
            <li>Sub-skill 2.1</li>
            <li>Sub-skill 2.2</li>
            <li>Sub-skill 2.3</li>
          </ul>
        </li>
        <li>Skill 3</li>
      </ul>
    </section>

    <section>
      <h2
        class="border-b border-(--global-border-color) pb-1 text-xl font-bold text-(--global-text-color)"
      >
        Publications
      </h2>
      <ul
        class="mt-3 list-disc space-y-3 pl-5 text-sm text-(--global-text-color)"
      >
        {
          publications.map((pub) => (
            <li>
              <a
                href={getPubUrl(pub)}
                class="font-semibold text-(--global-link-color) hover:underline"
                set:html={renderMath(pub.data.title)}
              />
              {pub.data.citation && (
                <p
                  class="text-xs text-(--global-text-color-light)"
                  set:html={renderMath(pub.data.citation)}
                />
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2
        class="border-b border-(--global-border-color) pb-1 text-xl font-bold text-(--global-text-color)"
      >
        Talks
      </h2>
      <ul
        class="mt-3 list-disc space-y-3 pl-5 text-sm text-(--global-text-color)"
      >
        {
          talks.map((talk) => (
            <li>
              <a
                href={getTalkUrl(talk)}
                class="font-semibold text-(--global-link-color) hover:underline"
                set:html={renderMath(talk.data.title)}
              />
              {(talk.data.talk_type ||
                talk.data.type ||
                talk.data.venue ||
                talk.data.location) && (
                <p class="text-xs text-(--global-text-color-light)">
                  {talk.data.talk_type || talk.data.type} at {talk.data.venue},{' '}
                  {talk.data.location}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2
        class="border-b border-(--global-border-color) pb-1 text-xl font-bold text-(--global-text-color)"
      >
        Teaching
      </h2>
      <ul
        class="mt-3 list-disc space-y-3 pl-5 text-sm text-(--global-text-color)"
      >
        {
          teaching.map((item) => (
            <li>
              <a
                href={getTeachingUrl(item)}
                class="font-semibold text-(--global-link-color) hover:underline"
                set:html={renderMath(item.data.title)}
              />
              {(item.data.type || item.data.venue || item.data.date) && (
                <p class="text-xs text-(--global-text-color-light)">
                  {item.data.type ? `${item.data.type}, ` : ''}
                  <em>{item.data.venue}</em>
                  {item.data.date
                    ? `, ${new Date(item.data.date).getFullYear()}`
                    : ''}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2
        class="border-b border-(--global-border-color) pb-1 text-xl font-bold text-(--global-text-color)"
      >
        Service and leadership
      </h2>
      <ul
        class="mt-3 list-disc space-y-1 pl-5 text-sm text-(--global-text-color)"
      >
        <li>Currently signed in to 43 different slack teams</li>
      </ul>
    </section>
  </div>
</SingleLayout>
