---
import { getEntry, render } from 'astro:content';

import PageLayout from '@layouts/PageLayout.astro';

import { buildProfilePageSchema } from '@utils/seo';
import { getSiteUrls } from '@utils/url';

const aboutPage = await getEntry('pages', 'about');
if (!aboutPage) throw new Error("Missing 'about' page in content/pages");

const { Content } = await render(aboutPage);

const { siteBase, canonicalUrl } = getSiteUrls(Astro.url, Astro.site);

const profilePageSchema = buildProfilePageSchema(
  canonicalUrl,
  siteBase,
  aboutPage.data.title,
  aboutPage.data.description
);
---

<PageLayout
  title={aboutPage.data.title}
  description={aboutPage.data.description}
  schemaNodes={[profilePageSchema]}
  ogType="profile"
  authorProfile={aboutPage.data.author_profile}
  toc={aboutPage.data.toc}
  image={aboutPage.data.image}
>
  <Content />
</PageLayout>
