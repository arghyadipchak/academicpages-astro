---
import { getEntry, render } from 'astro:content';

import PageLayout from '@layouts/PageLayout.astro';

const guidePage = await getEntry('pages', 'markdown');
if (!guidePage) throw new Error("Missing 'markdown' page in content/pages");

const { Content } = await render(guidePage);
---

<PageLayout
  title={guidePage.data.title}
  description={guidePage.data.description}
  authorProfile={guidePage.data.author_profile}
  toc={guidePage.data.toc}
  image={guidePage.data.image}
>
  <Content />
</PageLayout>
