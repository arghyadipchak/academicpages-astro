---
import { getCollection, render } from 'astro:content';

import { Icon } from 'astro-icon/components';

import PageLayout from '@layouts/PageLayout.astro';

import { formatDate } from '@utils/date';
import { parseInline } from '@utils/marked';
import {
  getFileSlug,
  getPortfolioUrl,
  getShortSlug,
  getTitleTransitionName,
} from '@utils/url';

export async function getStaticPaths() {
  const items = await getCollection('portfolio');
  const pathMap = new Map<string, (typeof items)[0]>();

  for (const item of items) {
    const fileSlug = getFileSlug(item.id);
    const shortSlug = getShortSlug(item.id);

    pathMap.set(fileSlug, item);
    if (shortSlug !== fileSlug) pathMap.set(shortSlug, item);

    if (item.data.permalink) {
      const cleanPermalink = item.data.permalink
        .replace(/^\/?portfolio\//, '')
        .replace(/\/$/, '')
        .replace(/^\//, '');
      pathMap.set(cleanPermalink, item);
    }
  }

  return Array.from(pathMap.entries()).map(([slug, item]) => ({
    params: { slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const formattedDate = formatDate(item.data.date);
const transitionName = getTitleTransitionName(getPortfolioUrl(item));
---

<PageLayout
  title={item.data.title}
  description={item.data.description}
  date={item.data.date}
  pdfUrl={item.data.pdf_url}
  slidesUrl={item.data.slides_url}
  codeUrl={item.data.code_url}
  authorProfile={item.data.author_profile}
  toc={item.data.toc}
  image={item.data.image}
  transitionName={transitionName}
>
  {(item.data.venue || item.data.timeline || formattedDate) && (
    <div
      slot="header-metadata"
      class="mt-2 space-y-1 text-sm text-(--global-text-color-light)"
    >
      {(item.data.timeline || formattedDate) && (
        <p class="archive-date-line inline-flex items-center gap-1.5 leading-none font-medium">
          <Icon name="fa6-solid:calendar" class="h-3.5 w-3.5 shrink-0" />
          <span>{item.data.timeline || `Date: ${formattedDate}`}</span>
        </p>
      )}
      {item.data.venue && <p set:html={parseInline(item.data.venue)} />}
    </div>
  )}
  <Content />
</PageLayout>
