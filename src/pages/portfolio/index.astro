---
import { getCollection } from 'astro:content';

import ListLayout from '@layouts/ListLayout.astro';
import PortfolioCard from '@components/PortfolioCard.astro';

import { getPortfolioUrl } from '@utils/url';

const allPortfolio = await getCollection('portfolio');
---

<ListLayout title="Portfolio">
  <div class="space-y-4">
    {allPortfolio.length > 0 ? (
      allPortfolio.map((item) => (
        <PortfolioCard
          title={item.data.title}
          url={getPortfolioUrl(item)}
          description={item.data.description}
          date={item.data.date}
          timeline={item.data.timeline}
          venue={item.data.venue}
          image={item.data.image}
        />
      ))
    ) : (
      <p class="text-sm text-(--global-text-color-light)">
        No portfolio items published yet.
      </p>
    )}
  </div>
</ListLayout>
