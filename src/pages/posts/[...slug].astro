---
import { getCollection, render } from 'astro:content';

import SingleLayout from '@layouts/SingleLayout.astro';

import { calculateReadingTime } from '@utils/readingTime';
import { getShortSlug } from '@utils/url';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const pathMap = new Map<string, (typeof posts)[0]>();

  for (const post of posts) {
    const shortSlug = getShortSlug(post.id);
    const date = new Date(post.data.date);
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');

    // Canonical date route: YYYY/MM/slug
    pathMap.set(`${year}/${month}/${shortSlug}`, post);

    // Explicit permalink if configured
    if (post.data.permalink) {
      const cleanPermalink = post.data.permalink
        .replace(/^\/?posts\//, '')
        .replace(/\/$/, '')
        .replace(/^\//, '');
      pathMap.set(cleanPermalink, post);
    } else {
      // Direct short slug alias
      pathMap.set(shortSlug, post);
    }
  }

  return Array.from(pathMap.entries()).map(([slug, post]) => ({
    params: { slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<SingleLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  modified={post.data.modified}
  tags={post.data.tags}
  collection="blog"
  authorProfile={post.data.author_profile}
  readTime={post.data.read_time ? calculateReadingTime(post.body) : undefined}
  toc={post.data.toc}
  image={post.data.image}
>
  <Content />
</SingleLayout>
