---
import { getCollection, render } from 'astro:content';
import SingleLayout from '../../layouts/SingleLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const pathMap = new Map<string, (typeof posts)[0]>();

  for (const post of posts) {
    let slug = post.id.replace(/\.md$/, '');
    if (post.data.permalink) {
      slug = post.data.permalink
        .replace(/^\/?posts\//, '')
        .replace(/\/$/, '')
        .replace(/^\//, '');
    }

    pathMap.set(slug, post);

    const shortId = post.id
      .replace(/\.md$/, '')
      .replace(/^\d{4}-\d{2}-\d{2}-/, '');
    if (!pathMap.has(shortId)) {
      pathMap.set(shortId, post);
    }
  }

  return Array.from(pathMap.entries()).map(([slug, post]) => ({
    params: { slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<SingleLayout
  title={post.data.title}
  description={post.data.excerpt || post.data.description}
  date={post.data.date}
  modified={post.data.modified}
  tags={post.data.tags}
  categories={post.data.categories}
  collection="blog"
  author_profile={post.data.author_profile}
  read_time={post.data.read_time}
>
  <Content />
</SingleLayout>
