---
import { getCollection, render } from 'astro:content';

import { Icon } from 'astro-icon/components';

import PageLayout from '@layouts/PageLayout.astro';

import { formatDate } from '@utils/date';
import { calculateReadingTime } from '@utils/readingTime';
import { getShortSlug } from '@utils/url';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const pathMap = new Map<string, (typeof posts)[0]>();

  for (const post of posts) {
    const shortSlug = getShortSlug(post.id);
    const date = new Date(post.data.date);
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');

    // Canonical date route: YYYY/MM/slug
    pathMap.set(`${year}/${month}/${shortSlug}`, post);

    // Explicit permalink if configured
    if (post.data.permalink) {
      const cleanPermalink = post.data.permalink
        .replace(/^\/?posts\//, '')
        .replace(/\/$/, '')
        .replace(/^\//, '');
      pathMap.set(cleanPermalink, post);
    } else {
      // Direct short slug alias
      pathMap.set(shortSlug, post);
    }
  }

  return Array.from(pathMap.entries()).map(([slug, post]) => ({
    params: { slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = formatDate(post.data.date);
const readTime = post.data.read_time
  ? calculateReadingTime(post.body)
  : undefined;
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  tags={post.data.tags}
  authorProfile={post.data.author_profile}
  toc={post.data.toc}
  image={post.data.image}
>
  {(formattedDate || readTime) && (
    <div
      slot="header-metadata"
      class="mt-2 flex flex-wrap items-center gap-3 text-sm text-(--global-text-color-light)"
    >
      {formattedDate && (
        <p class="inline-flex items-center gap-1.5 leading-none">
          <Icon name="fa6-solid:calendar" class="h-3.5 w-3.5 shrink-0" />
          <span>
            <strong>Published:</strong> {formattedDate}
          </span>
          {post.data.modified && (
            <span class="ml-2">
              (Updated: {formatDate(post.data.modified)})
            </span>
          )}
        </p>
      )}
      {readTime && (
        <p class="inline-flex items-center gap-1.5 leading-none">
          <Icon name="fa6-solid:clock" class="h-3.5 w-3.5 shrink-0" />
          <span>{readTime}</span>
        </p>
      )}
    </div>
  )}
  <Content />
</PageLayout>
