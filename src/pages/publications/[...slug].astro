---
import { getCollection, render } from 'astro:content';

import PageLayout from '@layouts/PageLayout.astro';

import { siteConfig } from '@data/siteConfig';
import { formatYear, toIsoDateString } from '@utils/date';
import {
  getFileSlug,
  getPublicationUrl,
  getShortSlug,
  getTitleTransitionName,
  resolveUrl,
} from '@utils/url';

export async function getStaticPaths() {
  const publications = await getCollection('publications');
  const pathMap = new Map<string, (typeof publications)[0]>();

  for (const pub of publications) {
    const fileSlug = getFileSlug(pub.id);
    const shortSlug = getShortSlug(pub.id);

    pathMap.set(fileSlug, pub);
    if (shortSlug !== fileSlug) pathMap.set(shortSlug, pub);

    if (pub.data.permalink) {
      const cleanPermalink = pub.data.permalink
        .replace(/^\/?publications?\//, '')
        .replace(/\/$/, '')
        .replace(/^\//, '');
      pathMap.set(cleanPermalink, pub);
    }
  }

  return Array.from(pathMap.entries()).map(([slug, pub]) => ({
    params: { slug },
    props: { pub },
  }));
}

const { pub } = Astro.props;
const { Content } = await render(pub);
const formattedYear = formatYear(pub.data.date);
const pdfUrl = pub.data.pdf_url ?? pub.data.paper_url;
const transitionName = getTitleTransitionName(getPublicationUrl(pub));

const citationMetadata = {
  title: pub.data.title,
  author: siteConfig.author.name,
  publicationDate: toIsoDateString(pub.data.date),
  journalTitle: pub.data.venue,
  pdfUrl: pdfUrl
    ? pdfUrl.startsWith('http')
      ? pdfUrl
      : new URL(
          resolveUrl(pdfUrl),
          Astro.site
            ? Astro.site.toString()
            : siteConfig.url
              ? new URL(siteConfig.url).origin
              : Astro.url.origin
        ).toString()
    : undefined,
};
---

<PageLayout
  title={pub.data.title}
  description={pub.data.description}
  date={pub.data.date}
  citation={pub.data.citation}
  citationMetadata={citationMetadata}
  pdfUrl={pdfUrl}
  slidesUrl={pub.data.slides_url}
  codeUrl={pub.data.code_url}
  bibtex={pub.data.bibtex}
  authorProfile={pub.data.author_profile}
  toc={pub.data.toc}
  image={pub.data.image}
  transitionName={transitionName}
>
  {pub.data.venue && (
    <p
      slot="header-metadata"
      class="mt-2 text-sm text-(--global-text-color-light)"
    >
      Published in <em>{pub.data.venue}</em>
      {formattedYear ? `, ${formattedYear}` : ''}
    </p>
  )}
  <Content />
</PageLayout>
