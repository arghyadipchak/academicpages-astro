---
import { getCollection, render } from 'astro:content';

import SingleLayout from '@layouts/SingleLayout.astro';

import { getFileSlug, getShortSlug } from '@utils/url';

export async function getStaticPaths() {
  const publications = await getCollection('publications');
  const pathMap = new Map<string, (typeof publications)[0]>();

  for (const pub of publications) {
    const fileSlug = getFileSlug(pub.id);
    const shortSlug = getShortSlug(pub.id);

    pathMap.set(fileSlug, pub);
    if (shortSlug !== fileSlug) {
      pathMap.set(shortSlug, pub);
    }

    if (pub.data.permalink) {
      const cleanPermalink = pub.data.permalink
        .replace(/^\/?publications?\//, '')
        .replace(/\/$/, '')
        .replace(/^\//, '');
      pathMap.set(cleanPermalink, pub);
    }
  }

  return Array.from(pathMap.entries()).map(([slug, pub]) => ({
    params: { slug },
    props: { pub },
  }));
}

const { pub } = Astro.props;
const { Content } = await render(pub);
---

<SingleLayout
  title={pub.data.title}
  description={pub.data.description}
  date={pub.data.date}
  venue={pub.data.venue}
  citation={pub.data.citation}
  pdfUrl={pub.data.pdf_url ?? pub.data.paper_url}
  slidesUrl={pub.data.slides_url}
  codeUrl={pub.data.code_url}
  bibtex={pub.data.bibtex}
  authorProfile={pub.data.author_profile}
  image={pub.data.image}
  toc={pub.data.toc}
  collection="publications"
>
  <Content />
</SingleLayout>
