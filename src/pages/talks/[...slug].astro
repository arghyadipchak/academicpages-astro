---
import { getCollection, render } from 'astro:content';

import { Icon } from 'astro-icon/components';

import PageLayout from '@layouts/PageLayout.astro';

import { formatDate } from '@utils/date';
import {
  getFileSlug,
  getShortSlug,
  getTalkUrl,
  getTitleTransitionName,
} from '@utils/url';

export async function getStaticPaths() {
  const talks = await getCollection('talks');
  const pathMap = new Map<string, (typeof talks)[0]>();

  for (const talk of talks) {
    const fileSlug = getFileSlug(talk.id);
    const shortSlug = getShortSlug(talk.id);

    pathMap.set(fileSlug, talk);
    if (shortSlug !== fileSlug) pathMap.set(shortSlug, talk);

    if (talk.data.permalink) {
      const cleanPermalink = talk.data.permalink
        .replace(/^\/?talks\//, '')
        .replace(/\/$/, '')
        .replace(/^\//, '');
      pathMap.set(cleanPermalink, talk);
    }
  }

  return Array.from(pathMap.entries()).map(([slug, talk]) => ({
    params: { slug },
    props: { talk },
  }));
}

const { talk } = Astro.props;
const { Content } = await render(talk);
const formattedDate = formatDate(talk.data.date);
const transitionName = getTitleTransitionName(getTalkUrl(talk));
---

<PageLayout
  title={talk.data.title}
  description={talk.data.description}
  date={talk.data.date}
  slidesUrl={talk.data.slides_url}
  authorProfile={talk.data.author_profile}
  toc={talk.data.toc}
  image={talk.data.image}
  transitionName={transitionName}
>
  {(formattedDate || talk.data.type || talk.data.venue) && (
    <div
      slot="header-metadata"
      class="mt-2 space-y-1 text-sm text-(--global-text-color-light)"
    >
      {formattedDate && (
        <p class="archive-date-line inline-flex items-center gap-1.5 leading-none font-medium">
          <Icon name="fa6-solid:calendar" class="h-3.5 w-3.5 shrink-0" />
          <span>Date: {formattedDate}</span>
        </p>
      )}
      {(talk.data.type || talk.data.venue) && (
        <p>
          {talk.data.type && talk.data.venue
            ? `${talk.data.type} at ${talk.data.venue}`
            : talk.data.type || talk.data.venue}
        </p>
      )}
    </div>
  )}
  <Content />
</PageLayout>
