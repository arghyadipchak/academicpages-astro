---
import { getCollection } from 'astro:content';

import ListLayout from '@layouts/ListLayout.astro';
import TalkCard from '@components/TalkCard.astro';

import { getTalkUrl } from '@utils/url';

const allTalks = await getCollection('talks');
allTalks.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<ListLayout title="Talks and Presentations">
  <div class="space-y-2">
    {allTalks.length > 0 ? (
      allTalks.map((talk) => (
        <TalkCard
          title={talk.data.title}
          url={getTalkUrl(talk)}
          description={talk.data.description}
          date={talk.data.date}
          type={talk.data.type}
          venue={talk.data.venue}
        />
      ))
    ) : (
      <p class="text-sm text-(--global-text-color-light)">
        No talks or presentations published yet.
      </p>
    )}
  </div>
</ListLayout>
