---
import { getCollection, render } from 'astro:content';

import SingleLayout from '../../layouts/SingleLayout.astro';
import { getFileSlug, getShortSlug } from '../../utils/url';

export async function getStaticPaths() {
  const teaching = await getCollection('teaching');
  const pathMap = new Map<string, (typeof teaching)[0]>();

  for (const item of teaching) {
    const fileSlug = getFileSlug(item.id);
    const shortSlug = getShortSlug(item.id);

    pathMap.set(fileSlug, item);
    if (shortSlug !== fileSlug) {
      pathMap.set(shortSlug, item);
    }

    if (item.data.permalink) {
      const cleanPermalink = item.data.permalink
        .replace(/^\/?teaching\//, '')
        .replace(/\/$/, '')
        .replace(/^\//, '');
      pathMap.set(cleanPermalink, item);
    }
  }

  return Array.from(pathMap.entries()).map(([slug, item]) => ({
    params: { slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<SingleLayout
  title={item.data.title}
  description={item.data.description}
  year={item.data.year}
  semester={item.data.semester}
  venue={item.data.venue}
  type={item.data.type}
  authorProfile={item.data.author_profile}
  image={item.data.image}
  toc={item.data.toc}
  collection="teaching"
>
  <Content />
</SingleLayout>
