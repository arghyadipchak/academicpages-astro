---
import { getCollection, render } from 'astro:content';

import PageLayout from '@layouts/PageLayout.astro';

import {
  getFileSlug,
  getShortSlug,
  getTeachingUrl,
  getTitleTransitionName,
} from '@utils/url';

export async function getStaticPaths() {
  const teaching = await getCollection('teaching');
  const pathMap = new Map<string, (typeof teaching)[0]>();

  for (const item of teaching) {
    const fileSlug = getFileSlug(item.id);
    const shortSlug = getShortSlug(item.id);

    pathMap.set(fileSlug, item);
    if (shortSlug !== fileSlug) pathMap.set(shortSlug, item);

    if (item.data.permalink) {
      const cleanPermalink = item.data.permalink
        .replace(/^\/?teaching\//, '')
        .replace(/\/$/, '')
        .replace(/^\//, '');
      pathMap.set(cleanPermalink, item);
    }
  }

  return Array.from(pathMap.entries()).map(([slug, item]) => ({
    params: { slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const termDisplay =
  item.data.semester && item.data.year
    ? `${item.data.semester} ${item.data.year}`
    : item.data.semester || (item.data.year ? `${item.data.year}` : '');

const transitionName = getTitleTransitionName(getTeachingUrl(item));
---

<PageLayout
  title={item.data.title}
  description={item.data.description}
  authorProfile={item.data.author_profile}
  toc={item.data.toc}
  image={item.data.image}
  transitionName={transitionName}
>
  {(item.data.venue || termDisplay || item.data.type) && (
    <p
      slot="header-metadata"
      class="mt-2 text-sm text-(--global-text-color-light)"
    >
      {item.data.type ? `${item.data.type}, ` : ''}
      {item.data.venue ? <em>{item.data.venue}</em> : ''}
      {termDisplay ? `, ${termDisplay}` : ''}
    </p>
  )}
  <Content />
</PageLayout>
