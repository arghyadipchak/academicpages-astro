---
import { getCollection, render } from 'astro:content';

import PageLayout from '@layouts/PageLayout.astro';

import { siteConfig } from '@data/siteConfig';
import { buildCourseSchema } from '@utils/seo';
import { getFileSlug, getShortSlug } from '@utils/url';

export async function getStaticPaths() {
  const teaching = await getCollection('teaching');
  const pathMap = new Map<string, (typeof teaching)[0]>();

  for (const item of teaching) {
    const fileSlug = getFileSlug(item.id);
    const shortSlug = getShortSlug(item.id);

    pathMap.set(fileSlug, item);
    if (shortSlug !== fileSlug) pathMap.set(shortSlug, item);

    if (item.data.permalink) {
      const cleanPermalink = item.data.permalink
        .replace(/^\/?teaching\//, '')
        .replace(/\/$/, '')
        .replace(/^\//, '');
      pathMap.set(cleanPermalink, item);
    }
  }

  return Array.from(pathMap.entries()).map(([slug, item]) => ({
    params: { slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const termDisplay =
  item.data.semester && item.data.year
    ? `${item.data.semester} ${item.data.year}`
    : item.data.semester || (item.data.year ? `${item.data.year}` : '');

const siteBase = Astro.site
  ? Astro.site.toString()
  : siteConfig.url
    ? new URL(siteConfig.url).origin
    : Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteBase).toString();

const courseSchema = buildCourseSchema(
  canonicalUrl,
  siteBase,
  item.data.title,
  item.data.description,
  item.data.venue,
  termDisplay
);
---

<PageLayout
  title={item.data.title}
  description={item.data.description}
  schemaNodes={[courseSchema]}
  authorProfile={item.data.author_profile}
  toc={item.data.toc}
  image={item.data.image}
>
  {
    (item.data.venue || termDisplay || item.data.type) && (
      <p
        slot="header-metadata"
        class="mt-2 text-sm text-(--global-text-color-light)"
      >
        {item.data.type ? `${item.data.type}, ` : ''}
        {item.data.venue ? <em>{item.data.venue}</em> : ''}
        {termDisplay ? `, ${termDisplay}` : ''}
      </p>
    )
  }
  <Content />
</PageLayout>
