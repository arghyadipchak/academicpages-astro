---
import { getCollection, render } from 'astro:content';

import PageLayout from '@layouts/PageLayout.astro';

import { buildCourseSchema } from '@utils/seo';
import { buildCollectionPaths, getSiteUrls } from '@utils/url';

export async function getStaticPaths() {
  const teaching = await getCollection('teaching');

  return buildCollectionPaths('teaching', teaching).map(({ slug, item }) => ({
    params: { slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);

const termDisplay =
  item.data.semester && item.data.year
    ? `${item.data.semester} ${item.data.year}`
    : item.data.semester || (item.data.year ? `${item.data.year}` : '');

const { siteBase, canonicalUrl } = getSiteUrls(Astro.url, Astro.site);

const courseSchema = buildCourseSchema(
  canonicalUrl,
  siteBase,
  item.data.title,
  item.data.description,
  item.data.venue,
  termDisplay
);
---

<PageLayout
  title={item.data.title}
  description={item.data.description}
  schemaNodes={[courseSchema]}
  authorProfile={item.data.author_profile}
  toc={item.data.toc}
  image={item.data.image}
>
  {
    (item.data.venue || termDisplay || item.data.type) && (
      <p
        slot="header-metadata"
        class="mt-2 text-sm text-(--global-text-color-light)"
      >
        {item.data.type ? `${item.data.type}, ` : ''}
        {item.data.venue ? <em>{item.data.venue}</em> : ''}
        {termDisplay ? `, ${termDisplay}` : ''}
      </p>
    )
  }
  <Content />
</PageLayout>
