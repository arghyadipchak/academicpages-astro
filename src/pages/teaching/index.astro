---
import { getCollection } from 'astro:content';

import ArchiveTeaching from '../../components/ArchiveTeaching.astro';
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import { sortTeaching } from '../../utils/date';
import { getTeachingUrl } from '../../utils/url';

const allTeaching = sortTeaching(await getCollection('teaching'));
---

<ArchiveLayout title="Teaching">
  <div class="space-y-2">
    {
      allTeaching.length > 0 ? (
        allTeaching.map((item) => (
          <ArchiveTeaching
            title={item.data.title}
            url={getTeachingUrl(item)}
            type={item.data.type}
            venue={item.data.venue}
            year={item.data.year}
            semester={item.data.semester}
            description={item.data.description}
          />
        ))
      ) : (
        <p class="text-sm text-(--global-text-color-light)">
          No teaching entries published yet.
        </p>
      )
    }
  </div>
</ArchiveLayout>
