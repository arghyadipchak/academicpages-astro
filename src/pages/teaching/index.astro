---
import { getCollection } from 'astro:content';

import ArchiveTeaching from '../../components/ArchiveTeaching.astro';
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import { getTeachingUrl } from '../../utils/url';

const allTeaching = await getCollection('teaching');
allTeaching.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<ArchiveLayout title="Teaching">
  <div class="space-y-2">
    {
      allTeaching.length > 0 ? (
        allTeaching.map((item) => (
          <ArchiveTeaching
            title={item.data.title}
            url={getTeachingUrl(item)}
            type={item.data.type}
            venue={item.data.venue}
            date={item.data.date}
            description={item.data.description}
          />
        ))
      ) : (
        <p class="text-sm text-(--global-text-color-light)">
          No teaching entries published yet.
        </p>
      )
    }
  </div>
</ArchiveLayout>
