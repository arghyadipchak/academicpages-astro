---
import { getEntry, render } from 'astro:content';

import PageLayout from '@layouts/PageLayout.astro';

const termsPage = await getEntry('pages', 'terms');
if (!termsPage) {
  throw new Error("Missing 'terms' page in content/pages");
}

const { Content } = await render(termsPage);
---

<PageLayout
  title={termsPage.data.title}
  description={termsPage.data.description}
  authorProfile={termsPage.data.author_profile}
  toc={termsPage.data.toc}
  image={termsPage.data.image}
>
  <Content />
</PageLayout>
